# 本地开发用：复制为 .env.local 后再填写真实值
# 注意：本文件是模板、会被提交到仓库，切勿把真实 Key 写在这里
# .env.local 已被 .gitignore 忽略，Key 只在 dev server 进程中使用，不会进入前端产物

# ---------- 1) 草图分析：DeepSeek 视觉模型 ----------

# DeepSeek API Key（必填；缺失时本地草图分析会走降级逻辑）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选：DeepSeek 接口地址，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# 可选：视觉模型名，默认 deepseek-flash
DEEPSEEK_MODEL=


# ---------- 2) 出图：火山方舟 · 即梦 Seedream ----------

# 火山方舟 API Key（缺失时 /api/sketch-to-image 返回本地占位图，流程仍可联调）
# 获取地址：https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=

# 可选：方舟接口地址，默认 https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=

# 可选：模型 ID，默认 doubao-seedream-4-0-250828
# 其它可用：doubao-seedream-4-5-*、doubao-seedream-5-0-*、doubao-seedream-5-0-pro-*
# 注意：使用时需先在方舟控制台「开通」对应模型
IMAGE_MODEL=

# 可选：输出尺寸，默认 2K；可填 1K / 2K / 4K，或精确像素如 2048x2048
IMAGE_SIZE=
